{
  "name": "desktop-todo-widget",
  "version": "1.0.0",
  "description": "桌面任务小工具 - 输入任务、自动生成列表、删除线动画、本地存储一周、窗口置顶",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.desktop.todo.widget",
    "productName": "今日任务",
    "directories": {
      "output": "build-release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "package.json",
      "icon.png"
    ],
    "asar": true,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "rfc3161TimeStampServer": ""
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "今日任务"
    }
  }
}
