{
  "name": "desktop-todo-widget",
  "version": "1.1.0",
  "description": "桌面任务小工具 - 输入任务、自动生成列表、删除线动画、本地存储一周、窗口置顶",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Qiujinan401X/daily-tasker.git"
  },
  "scripts": {
    "start": "electronmon .",
    "start:once": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:publish": "electron-builder --publish always"
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "package.json"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electronmon": "^2.0.4"
  },
  "build": {
    "appId": "com.desktop.todo.widget",
    "productName": "今日任务",
    "directories": {
      "output": "build-release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "package.json",
      "icon.png"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Qiujinan401X",
        "repo": "daily-tasker"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "rfc3161TimeStampServer": ""
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "今日任务"
    }
  }
}
